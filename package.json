{
  "name": "danielou-abidjan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/lib/db/seed.ts",
    "test": "vitest run",
    "test:unit": "vitest run --dir src/tests/unit",
    "test:quality": "vitest run --exclude 'src/tests/ws002/composition-workspace.test.ts' --exclude 'src/tests/ws002/composition-data-service.test.ts' --exclude 'src/tests/compositions-hf3-regression.test.ts' --exclude 'src/tests/evaluations-hf2-regression.test.ts' --exclude 'src/tests/hf3-r1-regression.test.ts'",
    "test:db-integration": "vitest run --config vitest.config.db.ts src/tests/ws002/composition-workspace.test.ts src/tests/ws002/composition-data-service.test.ts src/tests/compositions-hf3-regression.test.ts src/tests/evaluations-hf2-regression.test.ts src/tests/hf3-r1-regression.test.ts",
    "test:watch": "vitest",
    "check:sqlite": "bash scripts/check-no-sqlite.sh"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@neondatabase/serverless": "^1.1.0",
    "@tanstack/react-query": "^5.102.2",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.9",
    "lucide-react": "^1.33.0",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "pdfkit": "^0.20.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "eslint-plugin-drizzle": "^0.2.3",
    "jsdom": "^30.0.1",
    "mammoth": "^1.12.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "postgres": "^3.4.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20"
  }
}
